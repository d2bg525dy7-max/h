# Настройки бота Nexus. Никому не показывайте этот файл и не выкладывайте его в публичный репозиторий.

# Токен от @BotFather
BOT_TOKEN=

# Telegram ID людей, вписанных в код (владелец, разработчик), через запятую: 111111111,222222222
DEV_IDS=

# ID беседы администрации
ADMIN_CHAT_ID=

# ID беседы тех. админов (сюда приходят баги, жалобы, аудит дня)
STAFF_CHAT_ID=

# ID беседы логов
LOG_CHAT_ID=

# ID беседы главной администрации (почти все команды, /works)
MAIN_CHAT_ID=

# ID беседы отдела обучения (итоги дня, наказания)
EDU_CHAT_ID=

# ID беседы INFO администрации (повышения, понижения, назначения, смена должности)
INFO_CHAT_ID=

# ID беседы разработчиков (тест: работают все команды, доступы проверяются)
DEV_CHAT_ID=

# Куда присылать ежедневную копию базы. Пусто = в личку вписанным в код (рекомендуется: в базе есть переписки)
BACKUP_CHAT_ID=

# Файл базы данных (можно не менять)
DB_PATH=nexus.db
